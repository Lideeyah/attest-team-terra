# The Attest API the browser talks to. Everything else is server-side.
NEXT_PUBLIC_API_BASE_URL=

# "mock" runs the front end against the local mock server; "live" points at the backend.
ATTEST_API_MODE=

# "1" includes /dev/kitchen-sink and /dev/states in the build. Never set in production.
ATTEST_DEV_TOOLS=

# Xtradot platform team key. Server-side only. Never prefixed NEXT_PUBLIC_.
GATEWAY_KEY=

# Shared secret returned once when the Xtradot webhook is registered.
FORGE_WEBHOOK_SECRET=

# Session signing secret for Auth.js.
AUTH_SECRET=

# Postgres connection string, PostGIS enabled.
DATABASE_URL=

# Redis connection string for the disbursement queue.
REDIS_URL=

# Hedera Consensus Service credentials for period anchoring.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=

# Huawei model gateway for project design document extraction.
MAAS_ENDPOINT=
MAAS_API_KEY=
