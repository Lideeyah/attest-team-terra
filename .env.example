# PostgreSQL application role; run migrations with a separate owner URL.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Fixed HTTP listener port (default 8080).
PORT=8080
# Auth.js encrypted cookie secret, at least 32 random characters.
AUTH_SECRET=
# Optional comma-separated ingress proxy CIDRs approved for forwarded client addresses.
TRUST_PROXY=
# Each external provider is mock locally; live requires its credentials.
BANK_PROVIDER=mock
EXTRACTION_PROVIDER=mock
REGISTRY_PROVIDER=mock
MESSAGING_PROVIDER=mock
ANCHOR_PROVIDER=mock
# Inject GATEWAY_KEY from the huawei-gateway namespace secret; never populate it here.
BANK_URL=http://bank-api.ingress-apisix.svc.cluster.local/v1
MAAS_URL=http://huawei-maas.ingress-apisix.svc.cluster.local/openai/v1
MAAS_MODEL=glm-5.2
# Stable high-entropy identity pseudonymisation secret, supplied as a secret.
IDENTITY_PEPPER=
# Ed25519 PKCS8 private key, base64 encoded; supplied as a namespace secret.
SIGNING_KEY_BASE64=
# Secret returned by bank webhook registration.
FORGE_WEBHOOK_SECRET=
# Africa's Talking credentials and inbound callback authentication secret.
AT_USERNAME=
AT_API_KEY=
AT_CALLBACK_SECRET=
# Optional registry adapter endpoint; normalized Plan Vivo, Acorn or Gold Standard records.
# The bundled Plan Vivo reference works without a registry API; boundary upload remains separate.
REGISTRY_URL=
# Optional trusted Hedera bridge endpoint and key; disabled until configured.
ANCHOR_URL=
ANCHOR_API_KEY=
# Direct Hedera testnet anchoring when ANCHOR_PROVIDER=live and ANCHOR_URL is empty.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=
# SMTP verification/reset email delivery; inject these as secrets.
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Public receipt link origin.
PUBLIC_URL=http://localhost:8080

# AES-256 evidence encryption key; inject as a secret, never commit a populated value.
EVIDENCE_KEY_BASE64=
# Recover missed sandbox webhook deliveries through the durable worker.
WEBHOOK_RECOVERY_ENABLED=true
# Documented sandbox account control; applies only to bank-controlled intrabank accounts.
BANK_ACCOUNT_CONTROL_PATH=/admin/accounts/{account}/status
# Optional normalized flow bridge. Empty uses the documented transaction/history endpoints.
BANK_FLOW_PATH=
# Sandbox reseed tooling refuses live execution unless explicitly confirmed.
BANK_SANDBOX_CONFIRMED=false
