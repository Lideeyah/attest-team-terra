{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/[[...path]]",
      "regex": "^/api(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api(?:/(?<nxtPpath>.+?))?(?:/)?$"
    },
    {
      "page": "/attestation/[attestationId]",
      "regex": "^/attestation/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPattestationId": "nxtPattestationId"
      },
      "namedRegex": "^/attestation/(?<nxtPattestationId>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/attestation/[attestationId].segments/!KHB1YmxpYyk/attestation/$d$attestationId$segment",
          "source": "^/attestation/(?<nxtPattestationId>[^/]+?)\\.segments/!KHB1YmxpYyk/attestation/\\$d\\$attestationId(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPattestationId": "nxtPattestationId"
          }
        }
      ]
    },
    {
      "page": "/developers/[developerId]",
      "regex": "^/developers/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPdeveloperId": "nxtPdeveloperId"
