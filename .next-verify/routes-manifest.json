      "routeKeys": {
        "nxtPprojectId": "nxtPprojectId"
      },
      "namedRegex": "^/register/(?<nxtPprojectId>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/register/[projectId].segments/!KHB1YmxpYyk/register/$d$projectId$segment",
