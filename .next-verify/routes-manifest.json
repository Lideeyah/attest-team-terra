          "routeKeys": {
            "nxtPdeveloperId": "nxtPdeveloperId"
          }
        }
      ]
    },
    {
      "page": "/receipt/[token]",
      "regex": "^/receipt/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/receipt/(?<nxtPtoken>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/receipt/[token].segments/!KHJlY2VpcHQp/receipt/$d$token$segment",
          "source": "^/receipt/(?<nxtPtoken>[^/]+?)\\.segments/!KHJlY2VpcHQp/receipt/\\$d\\$token(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPtoken": "nxtPtoken"
          }
        }
      ]
    },
    {
      "page": "/receipt/[token]/confirm",
