{
  "name": "attest-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "local": "tsx scripts/local.ts",
    "build:production": "npm run build && node scripts/build-production.mjs",
    "build": "npm run build:contracts && tsc && node scripts/check-secrets.mjs && node scripts/check-types.mjs",
    "start": "node dist/src/main.js",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "reseed:bank": "tsx scripts/reseed-bank.ts",
    "test": "npm run build && node --test --test-concurrency=2 dist/tests/*.test.js",
    "check": "tsc --noEmit",
    "build:contracts": "tsc -p packages/contracts/tsconfig.json",
    "validate:schema": "prisma validate",
    "demo": "npm run build && node dist/scripts/demo.js",
    "demo:assets": "npm run build && node dist/scripts/demo-assets.js"
  },
  "dependencies": {
    "@attest/contracts": "file:packages/contracts",
    "@auth/core": "^0.41.3",
    "@fastify/multipart": "^9.3.0",
    "@hashgraph/sdk": "^2.81.0",
    "@vercel/functions": "^3.11.1",
    "fast-xml-parser": "^5.3.0",
    "fastify": "^5.6.2",
    "h3-js": "^4.3.0",
    "nodemailer": "10.4.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-postgis": "^0.2.16",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.6",
    "esbuild": "^0.28.2",
    "prisma": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@auth/core": {
      "nodemailer": "$nodemailer"
    },
    "@grpc/grpc-js": "1.14.7",
    "protobufjs@7.5.4": "7.6.6",
    "protobufjs@8.0.0": "8.8.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  }
}
