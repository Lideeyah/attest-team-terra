{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:production",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "functions": {"api/index.mjs": {"maxDuration": 300,"includeFiles": "{data,public,node_modules/@napi-rs/canvas,node_modules/@napi-rs/canvas-linux-x64-gnu,node_modules/pdfjs-dist/legacy/build}/**"}},
  "rewrites": [{"source": "/(.*)", "destination": "/api/index"}],
  "crons": [{"path": "/internal/tick", "schedule": "0 3 * * *"}]
}
